# PostgreSQL Neon connection strings
# DATABASE_URL is the pooled connection (use PgBouncer / Neon pooled URL with sslmode=require)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL is the direct unpooled connection used for Prisma migrations
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT configuration
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_at_least_32_chars_long"
JWT_EXPIRES_IN="1d"

# Server configuration
PORT=5000
CLIENT_URL="http://localhost:5173"

# Seed administrator account configuration
# ADMIN_NAME must be 20 to 60 characters
ADMIN_NAME="System Administrator Account"
ADMIN_EMAIL="admin@storerating.com"
# ADMIN_PASSWORD must be 8-16 chars with at least one uppercase letter and at least one special character
ADMIN_PASSWORD="Admin@123456"
# ADMIN_ADDRESS must be <= 400 characters
ADMIN_ADDRESS="100 Headquarters Boulevard, Suite 400, New York, NY 10001"
